# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string_here

# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
# Use a stable URL for OAuth callbacks (Google/GitHub/Slack/Notion).
# Keep this localhost while developing to avoid redirect_uri_mismatch with rotating ngrok URLs.
OAUTH_PUBLIC_URL=http://localhost:3000

# Google Apps Script Mail Engine
# Use the deployed Web App /exec URL, not the /dev editor test URL.
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: set the same value in Apps Script project properties as MAIL_WEBHOOK_SECRET.
MAIL_WEBHOOK_SECRET=change_me

# OAuth Connectors (one-click connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_SCOPES=chat:write,channels:read,groups:read,incoming-webhook
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_SCOPES=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SCOPES=read:user,user:email,repo

# WhatsApp Cloud API (can also be saved per-user from the Apps page)
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=
